{
  "name": "thread",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "One thread through a city: a Qloo-grounded itinerary for a person, not a list.",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c cyan,magenta \"tsx watch server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "smoke": "tsx scripts/smoke.ts",
    "cities:check": "tsx scripts/cities-check.ts",
    "debug:discover": "tsx scripts/debug-discover.ts",
    "typecheck": "tsc --noEmit",
    "qloo:doctor": "node scripts/qloo-doctor.mjs"
  },
  "dependencies": {
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
