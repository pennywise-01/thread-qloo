# ---------------------------------------------------------------------------
# Qloo credentials — SERVER ONLY.
#
# Never expose these to the browser, never prefix them with VITE_, and never
# commit a real value. The Vite client bundle must not contain any Qloo secret.
# ---------------------------------------------------------------------------

# Mock mode ranks venues locally from interest tags. No credential needed.
# Switch to "live" to rank through the Qloo harness.
QLOO_MODE=mock

# Hackathon API, not the production API.
QLOO_BASE_URL=https://hackathon.api.qloo.com
QLOO_TRUSTED_BASE_URL=https://hackathon.api.qloo.com

# Option A: let the harness hold the credential (`qloo setup --qloo`). Preferred.
# Option B: set it here for a server deployment. Still server-only.
# QLOO_API_KEY=

# Server port for the API and the built client.
PORT=8787

# Optional: path to the `qloo` binary if it is not on PATH.
# QLOO_BIN=qloo
